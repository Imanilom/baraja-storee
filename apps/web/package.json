    "next": "^14.2.3",
    "pdfjs-dist": "5.4.394",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "read-excel-file": "^9.3.17",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3"
  }
