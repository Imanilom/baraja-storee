{
  "name": "purchasing-management-system",
  "version": "1.0.0",
  "description": "Integrated Purchasing Management System (Web Next.js, Mobile React Native/Expo, Backend Node.js Express)",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "start:api": "npm run start --workspace=apps/api",
    "test:api": "npm run test --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "android:mobile": "npm run android --workspace=apps/mobile"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "keywords": [
    "purchasing",
    "marketlist",
    "receiving",
    "modular-monolith"
  ],
  "author": "",
  "license": "ISC"
}